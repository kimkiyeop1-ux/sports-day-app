rules_version = '2';

// =============================================================
// 체육대회 원앱 보안 규칙
// 핵심 원칙: 공개 화면이 읽을 수 있는 곳은 public/ 뿐이며,
//            public/ 에는 총점·순위·종목별 획득 점수가 절대 저장되지 않는다.
//            나머지(private/, audit/ 등)는 관리자만 읽을 수 있다.
// =============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 심판 = 관리자가 나눠 준 종목 링크(무작위 토큰) + 6자리 PIN을 입력해 '심판 세션'을 만든 익명 로그인 기기.
    // 관리자가 PIN·링크를 새로 만들면 예전 세션은 자동으로 무효가 된다(세션의 토큰·PIN이 현재 값과 달라지므로).
    function refKey(t, ev) {
      return get(/databases/$(database)/documents/tournaments/$(t)/private/referee).data.keys[ev];
    }
    function refSession(t) {
      return get(/databases/$(database)/documents/tournaments/$(t)/refSessions/$(request.auth.uid)).data;
    }
    function isReferee(t, ev) {
      let s = refSession(t);
      let k = refKey(t, ev);
      return signedIn() && s.ev == ev && s.token == k.token && s.pin == k.pin;
    }

    // 관리자 = meta/admins 문서의 uids 목록에 있는 계정 (Firebase 콘솔에서만 수정 가능)
    function isAdmin() {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/meta/admins).data.uids;
    }

    match /meta/active {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /meta/admins {
      allow read: if isAdmin();
      // 최초 1회: 관리자 목록이 아직 없을 때만, Google로 로그인한 사람이 '자기 자신만' 등록할 수 있다.
      // 한 번 만들어진 뒤에는 앱에서 절대 수정·삭제할 수 없다(바꾸려면 Firebase 콘솔에서).
      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasOnly(['uids'])
        && request.resource.data.uids == [request.auth.uid];
      allow update, delete: if false;
    }

    // 보안 규칙 버전 확인용(앱이 '규칙 업데이트 필요'를 알려줄 때 사용). 문서는 실제로 없고 쓰기는 불가.
    // 규칙을 바꿀 때마다 목록 끝에 새 번호를 추가하고 src/lib/rulesVersion.ts 의 RULES_VERSION 도 같이 올린다.
    // 예전 번호를 남겨 두는 이유: 안정판(예전 버전) 앱도 이 규칙을 '최신'으로 인식하게 하려고.
    // (규칙이 예전 앱과 호환되지 않게 바뀌면 그때는 예전 번호를 빼야 한다)
    match /meta/{check} {
      allow read: if check in ['rulesCheck_v1', 'rulesCheck_v2'];
    }

    match /tournaments/{t} {
      // 공개용 문서: 누구나 읽기, 관리자만 쓰기
      match /public/{docId} {
        allow read: if true;
        allow write: if isAdmin();
        // 심판: 자기 종목의 경기 결과 문서(public/results_{종목})의 결과·기록 칸만 고칠 수 있다
        allow update: if docId.matches('results_.+')
          && isReferee(t, docId.replace('^results_', ''))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['r', 'rec', 'updatedAt']);
      }

      // 심판 세션: 링크 토큰 + PIN이 맞아야 만들 수 있다. 자기 것만 읽기 가능.
      match /refSessions/{uid} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['ev', 'token', 'pin', 'name', 'at'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
          && request.resource.data.token == refKey(t, request.resource.data.ev).token
          && request.resource.data.pin == refKey(t, request.resource.data.ev).pin;
        allow delete: if isAdmin();
      }

      // 관리자 전용: 설정(배점), 시나리오 기록, 점수 등
      match /private/{docId} {
        allow read, write: if isAdmin();
      }

      // 변경 이력: 관리자만 읽기. 추가만 가능하고 수정 불가.
      // (삭제는 '전체 초기화'를 위해 관리자에게만 허용)
      match /audit/{id} {
        allow read: if isAdmin();
        allow create: if request.resource.data.actor == request.auth.uid
          && (isAdmin() || (request.resource.data.ev is string && isReferee(t, request.resource.data.ev)));
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // 그 외 모든 경로는 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
